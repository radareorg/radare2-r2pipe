{
  "name": "r2pipe-ts",
  "version": "0.3.0",
  "description": "TypeScript r2pipe API",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"r2pipe/*.ts\"",
    "wasm": "node wasm-download.cjs",
    "test": "npm run build && tsc -p tests/tsconfig.json && node --test tests/*.test.cjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "README.md",
    "package.json",
    "package-lock.json",
    "wasm-download.cjs",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "keywords": [
    "radare",
    "radare2",
    "r2",
    "reversing",
    "disassembler",
    "hexadecimal",
    "editor",
    "exploit",
    "exploiting"
  ]
}
